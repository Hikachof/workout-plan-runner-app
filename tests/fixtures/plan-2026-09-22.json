      "target": "20〜30回 × 1〜2セット",
      "metrics": [
        "reps",
        "sets"
      ],
      "memo": "日課として管理"
    },
    {
      "taskId": "daily-deep-squat-hold",
      "name": "ディープスクワット静止",
      "target": "週3回目安: 自重 5〜8回 × 2セット / 最下部5秒静止",
      "metrics": [
        "reps",
        "sets",
        "bottomHoldSeconds",
        "pain",
        "heelContact",
        "kneeTracking"
      ],
      "memo": "約3秒でしゃがみ、痛みなく保てる最下部で5秒静止。かかとが大きく浮かない・後方へ倒れない・膝が内側に入らない深さまで。壁や机につかまって可。鋭い痛み、引っ掛かり、腫れ、強い圧迫感があれば中止。呼吸を止めず、体幹を自然に保つ。"
    },
    {
      "taskId": "daily-core-relax-breath",
      "name": "コアリラックス呼吸",
      "target": "毎日 朝/夜: 仰向け 30%で2秒引き上げ→5秒脱力 × 3〜5回",
      "metrics": [
        "slowContractions",
        "quickContractions",
        "holdSeconds",
        "relaxSeconds",
        "sets",
        "tensionOrPain"
      ],
      "memo": "最初は正しい力の入れ方探し優先。呼吸を止めず、お尻・太もも・腹筋を固めず、下腹部の奥を軽く引き上げる感覚で行う。毎回完全に緩める。下へ押し出す力みは避ける。痛み、違和感、力みが残る感じがあれば中止または負荷を下げる。"
    }
  ],
