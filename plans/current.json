  "startDate": "2026-11-09",
  "endDate": "2026-11-22",
  "unit": "kg",
  "dailyTaskTemplate": [
    {
      "taskId": "daily-chinning",
      "name": "チンニング",
      "target": "10回前後 × 3セット",
      "metrics": [
        "reps",
        "sets"
      ],
      "memo": "肩幅より少し広く、手のひらを前に向けてバーを握る\n肩を下げ、胸をバーに近づけるつもりで体を引き上げる\nあごがバーを越えたら、2秒かけてゆっくり下ろす\n反動は使わない。上がらない回は、跳んで上がってゆっくり下ろすだけでもよい"
    },
    {
      "taskId": "daily-hanging-knee-up",
      "name": "ハンギングニーアップ",
      "target": "10回 × 3セット",
      "metrics": [
        "reps",
        "sets",
        "legRaiseAngle",
        "topHoldSeconds",
        "noSwing",
        "loweringSpeed",
        "posteriorPelvicTilt"
      ],
      "memo": "バーにぶら下がり、体の揺れを止めてから始める\n腰を丸めるように、ひざを胸へ引き上げる\nいちばん上で1秒止める\n2秒かけて下ろす。揺れたら一度止めてから次の回へ"
    },
    {
      "taskId": "daily-abs",
      "name": "腹筋",
      "target": "20〜30回 × 2〜3セット",
      "metrics": [
        "reps",
        "sets"
      ],
      "memo": "仰向けで、ひざを立てる\n息を吐きながら、おへそをのぞくように肩甲骨が床から浮くまで起こす\nゆっくり戻す。反動を使わない・首を手で引っ張らない"
    },
    {
      "taskId": "daily-plank",
      "name": "プランク",
      "target": "100秒 × 1〜2セット",
      "metrics": [
        "seconds",
        "sets"
      ],
      "memo": "ひじを肩の真下につき、つま先で体を支える\n頭からかかとまで一直線。腰を落とさない・上げない\n息は止めずに続ける\n形が崩れたら、その時点で終わりにする"
    },
    {
      "taskId": "daily-pushup",
      "name": "プッシュアップ",
      "target": "20〜30回 × 1〜2セット",
      "metrics": [
        "reps",
        "sets"
      ],
      "memo": "手は肩幅より少し広くつく\n体を一直線のまま、胸が床の近くに来るまで下ろす\nひじは体から斜め45度くらいに開く\n腰が落ちてきたら、そのセットは終わり"
    },
    {
      "taskId": "daily-deep-squat-hold",
      "name": "ディープスクワット静止",
      "target": "週3回目安：自重 5〜8回 × 2セット・いちばん下で5秒止める",
      "metrics": [
        "reps",
        "sets",
        "bottomHoldSeconds",
        "pain",
        "heelContact",
        "kneeTracking"
      ],
      "memo": "3秒かけてしゃがむ。壁や机につかまってよい\n痛みなく保てるいちばん深い所で5秒止める\nかかとを大きく浮かせない・ひざを内側に入れない・後ろに倒れない\n鋭い痛み、引っかかり、腫れ、強い圧迫感があればやめる\n脚の日は省いてよい"
    },
    {
      "taskId": "daily-core-relax-breath",
      "name": "コアリラックス呼吸",
      "target": "朝と夜：2秒そっと引き上げる → 5秒ゆるめる × 5回",
      "metrics": [
        "slowContractions",
        "quickContractions",
        "holdSeconds",
        "relaxSeconds",
        "sets",
        "tensionOrPain"
      ],
      "memo": "仰向けに寝てひざを立て、体の力を抜く\n息を吐きながら、体の底（いすに座ったときに座面に当たる所の内側）を、内側・上へそっと引き上げる。強さは全力の3割くらい\nそのまま2秒。お尻・太もも・お腹には力を入れない。息も止めない\n5秒かけて、完全にゆるめる（ゆるめる方が大事）\nこれを5回。分からない日は、力を入れずに呼吸だけでもよい。痛み・違和感があればやめる"
    }
  ],
